<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
      <PackageReference Include="Terminal.Gui" Version="1.17.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Atad.Application\Atad.Application.csproj" />
      <ProjectReference Include="..\Atad.Domain\Atad.Domain.csproj" />
      <ProjectReference Include="..\Atad.Infrastructure\Atad.Infrastructure.csproj" />
    </ItemGroup>

</Project>
